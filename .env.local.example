# Required in production: used to encrypt the API key cookie so each user's key is stored securely in their browser.
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=your_32_char_or_longer_secret_here

# Optional (local dev only): skip onboarding by using this key. In production, do NOT set this; users enter their own key in the app.
# Get your API key from https://aistudio.google.com/
# GEMINI_API_KEY=your_api_key_here

# Optional: for "Upload to Drive" in the Gallery. Create OAuth 2.0 Client ID (Web) at https://console.cloud.google.com/apis/credentials and add the Drive API.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional: set before `npm install` if Central Icons license check fails (pipeline node icons). Get a key from https://centralicons.com/
# CENTRAL_LICENSE_KEY=your_license_key
