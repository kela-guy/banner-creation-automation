# Production / deploy: ENCRYPTION_SECRET + AUTH vars are required.
# Users enter their own Gemini API key in the app; you do NOT set GEMINI_API_KEY in production.

# Required: encrypts the cookie where each user's API key is stored.
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=your_32_char_or_longer_secret_here

# Required: Google OAuth for login. Create at https://console.cloud.google.com/apis/credentials (Web application type).
# Add redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Required: secret used to sign session JWTs.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Required in production: canonical URL of your app.
# NEXTAUTH_URL=https://your-domain.com

# Optional: "Upload to Drive" in the Gallery (same Client ID as above, exposed to the browser for client-side GSI).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
